---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../url';
import { github } from '../data/packages';
---
<header class="site-header">
    <a class="logo" href={url()}>php-ffi</a>
    <nav aria-label="Main">
        <a href={url('parser/')}>Manual</a>
        <a class="wide" href={`${url()}#packages`}>Packages</a>
        <a href={github}>GitHub</a>
        <ThemeToggle />
    </nav>
</header>

<style>
.site-header { display: flex; justify-content: space-between; align-items: baseline; gap: 2rem; padding: 1.75rem var(--pad); }
.logo { font: 400 1.5rem var(--font-display); color: inherit; text-decoration: none; }
nav { display: flex; align-items: baseline; gap: 2rem; font: 700 .8rem var(--font-mono); text-transform: uppercase; letter-spacing: .15em; }
nav a { color: inherit; text-decoration: none; }
nav a:hover, .logo:hover { color: var(--link-hover); }
@media (max-width: 40rem) {
    nav { gap: 1.25rem; }
    .wide { display: none; }
}
</style>
