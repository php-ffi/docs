---
// A text switch between the dark and the light theme.
---
<button class="theme-toggle" type="button" aria-label="Switch colour theme">
    <span class="when-dark">Light</span><span class="when-light">Dark</span>
</button>

<script>
    for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
        button.addEventListener('click', () => {
            const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
            document.documentElement.dataset.theme = next;
            localStorage.setItem('starlight-theme', next);
        });
    }
</script>

<style>
.theme-toggle {
    font: 700 .8rem var(--font-mono); text-transform: uppercase; letter-spacing: .15em;
    color: inherit; background: none; border: 0; padding: 0; cursor: pointer;
}
.theme-toggle:hover { color: var(--link-hover); }
.when-light { display: none; }
:global([data-theme='light']) .when-dark { display: none; }
:global([data-theme='light']) .when-light { display: inline; }
</style>
