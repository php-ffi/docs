---
import Stripes from './Stripes.astro';
import { github } from '../data/packages';
---
<footer class="site-footer">
    <Stripes size="6px" />
    <div class="row">
        <span>php-ffi · MIT License</span>
        <a href={github}>github.com/php-ffi</a>
    </div>
</footer>

<style>
.row { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 1.25rem var(--pad); font: 600 .7rem var(--font-mono); text-transform: uppercase; letter-spacing: .2em; color: var(--dim); }
a { color: inherit; text-decoration: none; }
a:hover { color: var(--link-hover); }
</style>
