---
// The five-colour racing stripes, the only ornament of the site.
interface Props {
    class?: string;
    /** Height of a single stripe, any CSS length. */
    size?: string;
}

const { class: className = '', size } = Astro.props;
---
<span class:list={['stripes', className]} style={size ? `--stripe: ${size}` : undefined} aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i>
</span>

<style>
.stripes { display: flex; flex-direction: column; }
i { display: block; height: var(--stripe); }
i:nth-child(1) { background: var(--c-red); }
i:nth-child(2) { background: var(--c-orange); }
i:nth-child(3) { background: var(--c-mustard); }
i:nth-child(4) { background: var(--c-cream); }
i:nth-child(5) { background: var(--c-teal); }
/* On the cream background the cream stripe disappears. */
:global([data-theme='light']) i:nth-child(4) { background: var(--c-black); }
</style>
